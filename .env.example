# Optional Supabase sync. The app works without these.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Client-safe URL for production AI proxy. Example:
# EXPO_PUBLIC_AI_PROXY_URL=https://your-project-ref.supabase.co/functions/v1/consultation
EXPO_PUBLIC_AI_PROXY_URL=

# Client-safe AdMob rewarded ad unit ID for AI credit rewards.
EXPO_PUBLIC_ADMOB_REWARDED_AD_UNIT_ID=

# Server-side only. Do not expose provider keys in client app code.
# Use these in a backend proxy such as Supabase Edge Function, Vercel, Render, Firebase, or development Expo API routes.
GEMINI_API_KEY=
GROQ_API_KEY=
